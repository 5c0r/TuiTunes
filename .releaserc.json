{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "CHANGELOG.md"
    }],
    "@semantic-release/npm",
    ["@semantic-release/github", {
      "successComment": false,
      "assets": [
        {"path": "artifacts/tui-tunes-darwin-arm64.tar.gz", "label": "TuiTunes darwin arm64 (tuimusic + spectrum helper)"},
        {"path": "artifacts/tui-tunes-darwin-arm64.tar.gz.sha256", "label": "tui-tunes-darwin-arm64.tar.gz.sha256"},
        {"path": "artifacts/tui-tunes-darwin-x64.tar.gz", "label": "TuiTunes darwin x64 (tuimusic + spectrum helper)"},
        {"path": "artifacts/tui-tunes-darwin-x64.tar.gz.sha256", "label": "tui-tunes-darwin-x64.tar.gz.sha256"},
        {"path": "artifacts/tuitunes-spectrum-helper.tar.gz", "label": "Universal spectrum helper app bundle (tar preserves modes/signature)"},
        {"path": "artifacts/tuitunes-spectrum-helper.tar.gz.sha256", "label": "tuitunes-spectrum-helper.tar.gz.sha256"}
      ]
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "package.json"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }]
  ]
}
